# ============================================================
# Resume Screening Engine Configuration
# ============================================================

# LLM provider:
# Supported values will be:
# gemini
# openai
# anthropic

LLM_PROVIDER=gemini

# Model name depends on the selected provider.
LLM_MODEL=

# API keys
# Keep these empty in the example file.
# Put real values only in .env

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================================
# GitHub
# ============================================================

# Optional.
# The application must work even when this is empty.
GITHUB_TOKEN=

# ============================================================
# Screening configuration
# ============================================================

INPUT_DIR=./resumes
OUTPUT_FILE=./output/results.json

# Maximum number of characters sent to the LLM from a resume.
# We will make the extraction layer aware of this later.
MAX_RESUME_CHARS=50000

# Whether GitHub enrichment is enabled.
ENABLE_GITHUB=true